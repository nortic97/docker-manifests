// ========================================
// Read application log file
// ========================================

local.file_match "es_store_logs" {
  path_targets = [
    {
      __path__ = "/var/log/es-store/*.log",
      service  = "es-store",
      env      = "local",
    },
  ]
}


// ========================================
// Read logs
// ========================================

loki.source.file "es_store" {
  targets    = local.file_match.es_store_logs.targets
  forward_to = [loki.write.loki.receiver]
}


// ========================================
// Send logs to Loki
// ========================================

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}