// ========================================
// Match application log files
// ========================================

local.file_match "application_logs" {
  path_targets = [
    // ========================================
    // Local environment
    // ========================================
    {
      __path__ = "/var/log/*/*.log",
      env      = "local",
    },

    // ========================================
    // DEV environment - Tomcat
    // ========================================
    {
      __path__ = "/var/log/tomcat/*/*.log",
      env      = "dev",
    },
  ]
}


// ========================================
// Read application logs
// ========================================

loki.source.file "application_logs" {
  targets    = local.file_match.application_logs.targets
  forward_to = [loki.process.application_logs.receiver]
}


// ========================================
// Process application logs
// ========================================

loki.process "application_logs" {

  // ----------------------------------------
  // Local example:
  // /var/log/es-store/es-store.log
  //
  // DEV example:
  // /var/log/tomcat/es-user/es-user.log
  // ----------------------------------------

  stage.regex {
    source     = "filename"
    expression = "/var/log/(?:[^/]+/)?(?P<service>[^/]+)/[^/]+\\.log"
  }

  // Add extracted service and environment
  // as Loki labels

  stage.labels {
    values = {
      service = "service",
      env     = "env",
    }
  }

  forward_to = [loki.write.loki.receiver]
}


// ========================================
// Send logs to Loki
// ========================================

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}